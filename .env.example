# Local development persists to .data/firstpoint.sqlite. Do not deploy local mode publicly.
FIRSTPOINT_STORAGE=local
FIRSTPOINT_ALLOW_LOCAL=true
# Configure BOTH values, set FIRSTPOINT_STORAGE=supabase, and apply the migration for cloud accounts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. No credential is sent to the browser.
OPENAI_API_KEY=
# Cloud onboarding reserves OPENAI_* secret names. This alternative is supported.
FIRSTPOINT_OPENAI_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_ASR_MODEL=gpt-4o-mini-transcribe
# Without OpenAI, local text observations are explicitly unscored and excluded from growth/skill promotion.
MAX_AUDIO_SECONDS=300
MEMORY_ENABLED=true
# Optional: exact deployed origin for CSRF protection behind a trusted reverse proxy.
APP_ORIGIN=
# Optional trusted development tunnel hostname (hostname only, no scheme or port).
FIRSTPOINT_DEV_ORIGIN=
